{
  "uid": "compunube-operations",
  "title": "Compunube Operations",
  "tags": [
    "compunube",
    "operations"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Target health",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "compunube-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "compunube-prometheus"
          },
          "expr": "up{job=~\"match-service-go|player-profile-rust|envoy|postgres\"}",
          "refId": "A",
          "legendFormat": "{{job}} {{instance_id}} {{instance}} {{kind}} {{reason}} {{pool}} {{state}} {{outcome}} {{method}} {{code}} {{alertname}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "value_and_name",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      }
    },
