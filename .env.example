POSTGRES_USER=compunube
POSTGRES_PASSWORD=
MATCH_DB_PASSWORD=
PLAYER_DB_PASSWORD=
MONITOR_DB_PASSWORD=
POSTGRES_DB=compunube
POSTGRES_PORT=5432
GO_HTTP_PORT=8080
ENVOY_GRPC_PORT=50051
ENVOY_ADMIN_PORT=9901
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
# H66: image tag and revision label used by scripts/deploy/deploy.sh (default: dev)
COMPUNUBE_IMAGE_TAG=dev
COMPUNUBE_REVISION=dev
# H66: https origin(s) of apps/web/server.mjs when browsers on other machines play
# (docs/deployment/https-lab.md), e.g. https://192.168.1.20:4173. Empty: same-host only.
PUBLIC_ORIGINS=
# Lab by roles (docs/deployment/lab-roles.md): where Go and Rust reach the
# database and Envoy on other machines, as host:port. Empty: same Compose project.
POSTGRES_ADDR=
PLAYER_PROFILE_GRPC_ADDR=
# Go origin the web client forwards /v1 to (read by scripts/lab.mjs web).
COMPUNUBE_GO_URL=
