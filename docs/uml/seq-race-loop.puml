@startuml seq-race-loop
!include seq-common.iuml
title D34.4 · Inputs, tick y snapshots
participant "Cliente" as C
participant "Go conexión\n(lector)" as Conn
participant "inputmailbox" as Box
participant "Go RoomLoop\n(tick 20 Hz)" as Room
participant "outbox por conexión" as Out

loop cada ≤ 50 ms mientras participa
  C -> Conn : race.input {raceId, seq, steer, netSide, boost, jumpSeq}
  Conn -> Conn : rate limit por conexión
  Conn -> Box : Offer (seq estrictamente creciente;\nduplicados/atrasados se descartan)
end
loop cada tick (50 ms)
  Room -> Box : última intención + un salto nuevo
  Room -> Room : mover, colisiones, recogidas\n(un único propietario por objeto), persecución, meta
  Room -> Out : race.event (feedback, deduplicable)
  alt tick par (10 Hz)
    Room -> Out : race.snapshot completo\n(todos los jugadores, 211 residuos, 21 salvavidas,\nlastProcessedInputSeq/JumpSeq)
  end
end
Out --> C : eventos y snapshots\n(snapshots coalescibles bajo backpressure)
C -> C : interpola 100 ms; la propiedad,\nvidas y estados vienen del snapshot
note over Room : Sin escritura a PostgreSQL por tick.\nUna conexión lenta se cierra sin bloquear la sala.
@enduml
